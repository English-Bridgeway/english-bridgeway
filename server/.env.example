# --- Server ---
PORT=4000
NODE_ENV=development
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/english_bridgeway
# Long random string used to sign admin sessions. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Optional: separate key for encrypting saved payment secrets (defaults to one derived from JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=
# Where the website is served (used for the payment return URL) and where this API is reachable
# from the internet (used for the Cashfree webhook URL).
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API from a browser (not needed when the API serves the site)
CORS_ORIGIN=http://localhost:5173

# --- First admin (created on start-up when no admin exists yet) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Owner

# --- Cashfree (optional: these can also be set in Admin → Payment gateway, which wins) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox

# --- Live voice chat (Speak Live) ---
# Public STUN servers, comma-separated (defaults to Google's when unset)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay (coturn with use-auth-secret). Leave empty to use STUN only.
TURN_URLS=
TURN_SECRET=
# Max people in a team room (2 to 12)
VOICE_MAX_ROOM_SIZE=6
