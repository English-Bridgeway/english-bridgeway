# Settings for `docker compose up` in the project root. Copy to .env and fill in.

# Port the website is published on (http://localhost:8080)
WEB_PORT=8080

# Database (only used inside Docker; change the password for a real server)
POSTGRES_DB=english_bridgeway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Long random string used to sign admin sessions. Required.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Optional: separate key for encrypting saved payment secrets (defaults to one derived from JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=

# Public address of the site. The API is served from the same address under /api,
# so both are the same (used for the payment return URL and the Cashfree webhook URL).
PUBLIC_SITE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# First admin, created on the first start when no admin exists yet (password: 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Owner

# Cashfree (optional: can also be set in Admin → Payment gateway, which wins)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox

# --- Live voice chat (Speak Live) ---
# Public STUN servers (comma-separated). The default Google ones are fine.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Max people in a team room. Everyone connects to everyone, so keep it small (2 to 12).
VOICE_MAX_ROOM_SIZE=6
# Optional TURN relay (docker compose --profile turn up -d). Needed for learners on networks
# that block direct calls. TURN_SECRET: any long random string (openssl rand -hex 32).
TURN_SECRET=
TURN_REALM=englishbridgeway.com
# e.g. turn:englishbridgeway.com:3478?transport=udp,turn:englishbridgeway.com:3478?transport=tcp
TURN_URLS=
# The server's public IP (leave empty to detect it automatically)
TURN_EXTERNAL_IP=
