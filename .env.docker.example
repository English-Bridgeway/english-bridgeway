# Settings for `docker compose up` in the project root. Copy to .env and fill in.

# Port the website is published on (http://localhost:8080)
WEB_PORT=8080

# Database (only used inside Docker; change the password for a real server)
POSTGRES_DB=english_bridgeway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Long random string used to sign admin sessions. Required.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Optional: separate key for encrypting saved payment secrets (defaults to one derived from JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=

# Public address of the site. The API is served from the same address under /api,
# so both are the same (used for the payment return URL and the Cashfree webhook URL).
# In production set both to https://englishbridgeway.com: search engines also get canonical
# links and sitemap.xml with this address until Admin → Site settings → Website address is set.
PUBLIC_SITE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# First admin, created on the first start when no admin exists yet (password: 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Owner

# Cashfree (optional: can also be set in Admin → Payment gateway, which wins)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox

# --- Speak with AI (optional: can also be set in Admin → AI tutor, which wins) ---
# Any OpenAI-compatible chat API. Free options: Groq (https://console.groq.com/keys) or
# Google Gemini (https://aistudio.google.com/apikey, base URL https://generativelanguage.googleapis.com/v1beta/openai).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=

# --- AI tutor voice (optional: can also be set in Admin → AI tutor → Tutor voice, which wins) ---
# ElevenLabs (https://elevenlabs.io/app/settings/api-keys). eleven_v3 speaks Marathi + English and
# acts audio tags like [laughs]. Without a key, the browser's own voice reads the replies.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_v3

# --- Live voice chat (Speak Live) ---
# Public STUN servers (comma-separated). The default Google ones are fine.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Max people in a team room. Everyone connects to everyone, so keep it small (2 to 12).
VOICE_MAX_ROOM_SIZE=6
# TURN relay (docker compose --profile turn up -d). Needed for calls on mobile data and many
# Wi-Fi networks, which block direct browser-to-browser audio ("Can't connect").
# TURN_SECRET: any long random string (openssl rand -hex 32).
TURN_SECRET=
TURN_REALM=englishbridgeway.com
# Leave empty to use turn:<PUBLIC_SITE_URL host>:3478 (UDP and TCP), or set e.g.
# turn:englishbridgeway.com:3478?transport=udp,turn:englishbridgeway.com:3478?transport=tcp
TURN_URLS=
# The server's public IP (leave empty to detect it automatically)
TURN_EXTERNAL_IP=

# E-books: largest PDF the admin can upload, in MB (also raise client_max_body_size on a host Nginx)
EBOOK_MAX_MB=100
